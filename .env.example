# ---- CPP Sales Hub settings ----
# Copy this file to ".env" and fill it in. Never share the .env file: it holds passwords and keys.

# The owner account. You sign in with this email and password the first time.
ADMIN_EMAIL=matt@cppsales.net
ADMIN_NAME=Matt Sanders
ADMIN_PASSWORD=change-me-to-something-long
# Keeps your existing leads, quotes and notes attached to you. Leave as is.
ADMIN_LEGACY_ID=u_Jo04j5wFTFsN5No5NHdmSw

# Password for the hub's own database. Any long random text. Set it once, before the first start.
DB_PASSWORD=change-me-too

# Claude AI (email summaries, reply drafts). Get a key at https://console.anthropic.com
# Leave blank to run without AI.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MODEL_QUICK=claude-haiku-5-5

# The address on this computer: http://localhost:8080
HUB_PORT=8080
